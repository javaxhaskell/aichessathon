# Public Supabase project details (safe for the browser; protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key. Prefer the current sb_secret_ key; the legacy
# service-role key is supported as a fallback. Never prefix either with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Registration stays closed until a legal controller is named and the rules
# version below has been reviewed. This fail-closed behavior is intentional.
REGISTRATION_LEGAL_CONTROLLER_NAME=
REGISTRATION_RULES_APPROVED=2026-08-24.v1

# Optional confirmation email via Resend
RESEND_API_KEY=
EMAIL_FROM="AI Chessathon <events@aichessathon.com>"
EMAIL_REPLY_TO=events@aichessathon.com

# Required: long random value used to rate-limit without retaining raw IPs
RATE_LIMIT_HMAC_SECRET=

# Secures the daily Vercel cleanup job for expired upload sessions
CRON_SECRET=
